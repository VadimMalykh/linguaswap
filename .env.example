# Copy to .env and fill in. .env is gitignored; Docker Compose reads it
# automatically and passes ANTHROPIC_API_KEY into the app container.
#
# Only needed for dictionary generation (mix linguaswap.import_words --generate).
# Everything else in the app runs without it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Total dollars one generation run may spend before it stops.
# Defaults to 5.0, which is several full runs of headroom.
# LINGUASWAP_LLM_COST_CAP_USD=5.0
